# Copy to watchdog.env (gitignored — never commit real values) and fill in.
# Both are optional: without them the watchdog still probes/relays/recovers,
# it just can't page you.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum-topic id inside TELEGRAM_CHAT_ID. Empty posts to the group's
# General thread (the pre-2026-08-25 behaviour), so leaving it unset is safe.
# It is the MIDDLE number of a topic message link: t.me/c/<internal>/<TOPIC>/<msg>
# TELEGRAM_TOPIC_ID=
#
# 🔴 If your group has forum topics ENABLED, Telegram has already upgraded it
# from `group` to `supergroup` and RE-ISSUED its chat id. The old id keeps
# failing forever with `group chat was upgraded to a supergroup chat`, and
# `getChat` still succeeds on BOTH ids returning the SAME title — so this is
# very easy to miss. It silently ate 50 alerts over 30 days on the reference
# deployment. watchdog.py now follows the `migrate_to_chat_id` the error body
# hands back, but fix it here so it does not re-learn it on every restart.

# Everything else has a working default (see the top of watchdog.py) — only
# override if your ports/hosts differ from a stock deployment of this repo.
# LLAMA_ROUTER_URL=http://127.0.0.1:9292
# LLAMA_UPSTREAM_HOST=          # defaults to 127.0.0.1; the router runs
#                               # --network host, so children are on loopback
# WATCHDOG_PORT=9611
# PROBE_INTERVAL=60
# SCRAPE_INTERVAL=15
# PROBE_TIMEOUT=90
# FAIL_THRESHOLD=3
# RECOVERY_COOLDOWN=1800
# PROBE_GRACE_SECONDS=300       # don't probe a model for this long after it
#                               # first appears `loaded` (it may still be warming)

# --- Wedge detection tuning ---
# SLOTS_TIMEOUT is how long to wait for /slots, which is the ONLY thing that
# distinguishes "busy prefilling" from "GPU wedged". It is served off the child's
# main loop, so during a long prefill it can be blocked for a whole ubatch
# (~17s per 2048 tokens at 70k ctx on a large MoE). Too low and the watchdog
# unloads healthy models mid-prefill — do not drop this back to 10.
# SLOTS_TIMEOUT=30
# MAX_INCONCLUSIVE=5            # consecutive unreadable-/slots cycles to excuse
#                               # before falling through to the recovery path

# --- Heavy-model mutex ---
# Enforces "at most one of these resident at a time". Exists because the router
# has no memory awareness (--models-max caps model COUNT, not size), so a client
# request naming an unloaded model starts loading it ON TOP of what is already
# resident — which is an OOM on any box where two of them don't fit.
# Set HEAVY_MODELS to your mutually-exclusive large models, or HEAVY_MUTEX=0 to
# disable. Leave models that must ALWAYS stay resident out of this list.
# HEAVY_MUTEX=1
# HEAVY_MODELS=modelA,modelB
# HEAVY_MUTEX_INTERVAL=3        # poll seconds; must be well under your load time
# HEAVY_EVICT_COOLDOWN=60       # per-model floor between evictions (anti-flap)

# Optional: also health-probe a Hindsight (https://github.com/vectorize-io/hindsight)
# memory daemon running alongside this stack. Unset means "not deployed, skip
# it silently" — you don't need Hindsight to use the rest of this watchdog.
# HINDSIGHT_URL=http://127.0.0.1:9177
# HINDSIGHT_PROBE_INTERVAL=60
# HINDSIGHT_FAIL_THRESHOLD=3

# --- Host health alerting (health_loop) ---
# Memory pressure + systemd unit liveness. Reads /proc directly, so it needs no
# Prometheus/exporter and keeps working if you retire your metrics stack.
# 🔴 Thresholds should be MEASURED on your box, not inherited. The defaults come
# from a 128 GB Strix Halo where GTT holds ~109 GiB: healthy sat at 5-7 GiB
# MemAvailable and the user-reported-bad state was 3.6-3.8 GiB.
# HEALTH_INTERVAL=60
# HEALTH_FAIL_THRESHOLD=3
# MEM_AVAIL_MIN_GIB=3.0
# SWAP_USED_MAX_FRAC=0.80
# RECLAIM_RATIO_MAX=3.0         # pgscan_direct/pgsteal_direct as a RATE over the
#                               # interval — NOT the cumulative quotient, which is
#                               # a lifetime average that never recovers once it
#                               # has thrashed. 6.0x measured while thrashing,
#                               # ~1.0 healthy.
# RECLAIM_MIN_SCAN=10000        # ignore the ratio below this much scanning
# HEALTH_UNITS=unitA.service,unitB.socket
#   Units whose death should page. Leave out anything you already probe more
#   deeply — a /health probe that checks real dependencies beats `is-active`,
#   which calls a wedged-but-running daemon "active".
