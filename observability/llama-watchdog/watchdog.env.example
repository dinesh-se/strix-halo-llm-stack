# Copy to watchdog.env (gitignored — never commit real values) and fill in.
# Both are optional: without them the watchdog still probes/relays/recovers,
# it just can't page you.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Everything else has a working default (see the top of watchdog.py) — only
# override if your ports/hosts differ from a stock deployment of this repo.
# LLAMA_SWAP_URL=http://127.0.0.1:9292
# LLAMA_UPSTREAM_HOST=          # auto-resolved via `docker inspect llama-swap` if unset
# WATCHDOG_PORT=9611
# PROBE_INTERVAL=60
# SCRAPE_INTERVAL=15
# PROBE_TIMEOUT=90
# FAIL_THRESHOLD=3
# RECOVERY_COOLDOWN=900

# Optional: also health-probe a Hindsight (https://github.com/vectorize-io/hindsight)
# memory daemon running alongside this stack. Unset means "not deployed, skip
# it silently" — you don't need Hindsight to use the rest of this watchdog.
# HINDSIGHT_URL=http://127.0.0.1:9177
# HINDSIGHT_PROBE_INTERVAL=60
# HINDSIGHT_FAIL_THRESHOLD=3
